{
  "properties": {
    "schema_version": {
      "const": "1.2",
      "default": "1.2",
      "title": "Schema Version",
      "type": "string"
    },
    "event": {
      "enum": [
        "message_received",
        "pii_redacted",
        "injection_blocked",
        "triaged",
        "model_failed",
        "decision_made",
        "flag_set",
        "flag_cleared",
        "retrieval_filtered",
        "approval_requested",
        "approval_reminder",
        "approval_escalated",
        "approval_decided",
        "action_executed",
        "action_denied",
        "case_state_changed",
        "case_closed",
        "copilot_answered",
        "dev_login",
        "misuse_refused"
      ],
      "title": "Event",
      "type": "string"
    },
    "actor": {
      "default": "system",
      "title": "Actor",
      "type": "string"
    },
    "ts": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ts"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Id"
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "policy_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Version"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    }
