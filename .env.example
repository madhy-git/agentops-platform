# Copy to .env (git-ignored). Only needed for live mode.
AGENTOPS_MODE=offline
AGENTOPS_DATABASE_URL=postgresql://agentops:agentops@localhost:5433/agentops
# LiteLLM gateway (docker compose --profile live up -d)
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-local-dev
LITELLM_MASTER_KEY=sk-local-dev
# Provider keys, read by LiteLLM, never by the app
ANTHROPIC_API_KEY=
# Tracing (optional): Jaeger via --profile tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
